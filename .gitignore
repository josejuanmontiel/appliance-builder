# Secretos y credenciales sensibles (WiFi, IPs locales, claves privadas)
app-payload/config/wifi.env
wifi.txt
ip.txt
config.local.env
config.runtime.env
*.env.local
*.env.*.local
*.secret
*.key
*.csr
