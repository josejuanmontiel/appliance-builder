# ==============================================================================
# Configuración por defecto para Alpine Appliance Builder
# ==============================================================================

# Versión y arquitectura objetivo de Alpine Linux
ALPINE_VERSION="3.19.1"
ALPINE_BRANCH="v3.19"
ALPINE_ARCH="armhf"
ALPINE_MIRROR="http://dl-cdn.alpinelinux.org/alpine"

# Nombre del appliance e imagen de salida
APPLIANCE_NAME="p2pt-box"
TARGET_BOARD="rpi-zero" # rpi-zero | rpi-3 | rpi-4 | generic-x86_64

# Configuración de Red por defecto (pueden sobreescribirse con flags CLI o variables de entorno)
WIFI_SSID=""
WIFI_PASS=""
STATIC_IP="192.168.1.50"
STATIC_NETMASK="255.255.255.0"
STATIC_GATEWAY="192.168.1.1"
STATIC_DNS="1.1.1.1 8.8.8.8"
HOSTNAME="p2pt-box"

# Contraseña de root por defecto (o pasar ROOT_PASSWORD en build)
ROOT_PASSWORD="alpine"

# Contraseña del Dashboard por defecto (o pasar ADMIN_PASSWORD en build)
ADMIN_PASSWORD="alpine"

# Etiqueta para partición FAT32 de arranque (máx 11 caracteres, ej. P2PT_BOOT, APPLIANCE)
# IMPORTANTE: NO usar "BOOT" debido a incompatibilidad con mcopy/mtools
BOOT_LABEL="P2PT_BOOT"

# Dimensiones del particionado de la imagen (.img)
BOOT_PART_MB=512
DATA_PART_MB=512

# Memoria de vídeo GPU en config.txt (MB)
GPU_MEM=64
